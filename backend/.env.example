# -----------------------------------
# SIGNAL — ENVIRONMENT
# -----------------------------------
#
# This file is a template and is committed.
# Never put real values in it.
#
# Copy it to .env, which is gitignored, and fill
# that in instead:
#
#     cp .env.example .env
#
# The Supabase values are in the dashboard for
# the SIGNAL project, under Settings -> API.
#
# The service role key bypasses row level
# security, so it belongs on the server only and
# must never reach the frontend or a commit.

SUPABASE_URL=https://your-project-ref.supabase.co

SUPABASE_SERVICE_KEY=your-service-role-key


# -----------------------------------
# SUMMARIES
# -----------------------------------
#
# A free key from Google AI Studio:
#
#     https://aistudio.google.com/apikey
#
# Gemini's Flash models are free to call, which
# is why they are the default here. Without this
# key the site still works -- articles just open
# with their original blurb instead of a summary.
#
# Note the free tier is metered per model per day,
# and the newest models get the smallest allowance
# (gemini-3.5-flash: twenty a day). The default is
# chosen for its allowance, not its version.

GEMINI_API_KEY=your-gemini-api-key

# Optional. Google renames these fairly often, so
# it can be overridden without touching the code.
# GEMINI_MODEL=gemini-2.5-flash
